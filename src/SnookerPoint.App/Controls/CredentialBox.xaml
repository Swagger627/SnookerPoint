<UserControl x:Class="SnookerPoint.App.Controls.CredentialBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        A single credential field with a robust show/hide. The authoritative value
        is the Password dependency property; the inner PasswordBox and TextBox are
        always kept in sync, so revealing/hiding never loses the value. Handlers are
        wired in the constructor (never lazily), so keystrokes always reach the VM.
    -->
    <Grid>
        <PasswordBox x:Name="Pb" Padding="9,8" FontSize="14" />
        <TextBox x:Name="Tb" Padding="9,8" FontSize="14" Visibility="Collapsed" />
    </Grid>
</UserControl>
