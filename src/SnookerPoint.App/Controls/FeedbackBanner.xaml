<UserControl x:Class="SnookerPoint.App.Controls.FeedbackBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl">
    <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" Padding="14,11" SnapsToDevicePixels="True"
            Background="{DynamicResource Brush.Card}">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Default = Success -->
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Warning">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Error">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    </DataTrigger>
                    <!-- Hide when there is no message -->
                    <DataTrigger Binding="{Binding Message, ElementName=RootControl}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Message, ElementName=RootControl}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon (colour is always paired with a glyph and words) -->
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                       FontFamily="Segoe UI Symbol" FontSize="16" FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#x2714;" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Warning">
                                <Setter Property="Text" Value="&#x26A0;" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Error">
                                <Setter Property="Text" Value="&#x2716;" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Message -->
            <TextBlock Grid.Column="1" Text="{Binding Message, ElementName=RootControl}" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Brush.Text}" />

            <!-- Dismiss -->
            <Button Grid.Column="2" Content="&#x2715;" Command="{Binding DismissCommand, ElementName=RootControl}"
                    VerticalAlignment="Top" Margin="10,-2,0,0" Cursor="Hand"
                    ToolTip="Dismiss" Foreground="{DynamicResource Brush.TextMuted}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDismiss, ElementName=RootControl}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
