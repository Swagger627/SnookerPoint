<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme colour tokens — the same clean, neutral, premium aesthetic as
        the dark theme. Soft off-white background, white cards, near-black text,
        the same single indigo accent. Same semantic keys as Dark.xaml so screens
        stay theme-agnostic.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Background"   Color="#F5F6F8" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Card"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardHover"    Color="#F1F3F6" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#E4E7EC" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#D2D6DE" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text"         Color="#1A1D23" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#5C6370" />
    <SolidColorBrush x:Key="Brush.TextSubtle"   Color="#868D99" />

    <!-- Accent (single cool indigo, used sparingly) -->
    <SolidColorBrush x:Key="Brush.Primary"        Color="#5E6AD2" />
    <SolidColorBrush x:Key="Brush.PrimaryHover"   Color="#4E58B8" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="#414AA0" />
    <SolidColorBrush x:Key="Brush.OnPrimary"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent"         Color="#5E6AD2" />
    <!-- Faint accent tint for subtle highlights / focus rings -->
    <SolidColorBrush x:Key="Brush.AccentSubtle"   Color="#ECEEFB" />

    <!-- Semantic (muted, not flashy) -->
    <SolidColorBrush x:Key="Brush.Success" Color="#2E9E6B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#C6871F" />
    <SolidColorBrush x:Key="Brush.Danger"  Color="#D24B44" />

    <!-- Table status tokens (for later phases; colour always paired with a label) -->
    <SolidColorBrush x:Key="Brush.Status.Available"       Color="#2E9E6B" />
    <SolidColorBrush x:Key="Brush.Status.Reserved"        Color="#5E6AD2" />
    <SolidColorBrush x:Key="Brush.Status.Running"         Color="#C6871F" />
    <SolidColorBrush x:Key="Brush.Status.Paused"          Color="#868D99" />
    <SolidColorBrush x:Key="Brush.Status.AwaitingPayment" Color="#D24B44" />
    <SolidColorBrush x:Key="Brush.Status.Cleaning"        Color="#2F97A3" />
    <SolidColorBrush x:Key="Brush.Status.Maintenance"     Color="#8A6A56" />

</ResourceDictionary>
