<UserControl x:Class="SnookerPoint.App.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Border Style="{StaticResource Card}" Padding="0"
                MaxWidth="660" MinWidth="520" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="32,28,32,0">
                    <TextBlock Text="Set up Snooker Point" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="{Binding StepIndicator}" Style="{StaticResource Text.Caption}" Margin="0,6,0,10" />
                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Primary}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- Step content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,20,32,10"
                              ctrl:SmoothScrollBehavior.Enabled="True">
                    <Grid>
                        <!-- STEP 1: Welcome -->
                        <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Welcome" Style="{StaticResource Text.Heading}" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                                       Text="This quick setup will get your club ready to use. We'll ask for your club name, tables, receipt preferences, and an owner account." />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                                       Text="Don't worry — you can change any of these settings later." />
                        </StackPanel>

                        <!-- STEP 2: Club details -->
                        <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Club details" Style="{StaticResource Text.Heading}" Margin="0,0,0,12" />

                            <TextBlock Text="Club name *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ClubName, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" FontSize="14" />

                            <TextBlock Text="Address (optional)" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" FontSize="14" />

                            <TextBlock Text="Phone (optional)" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" FontSize="14" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Currency" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource Brush.CardHover}" CornerRadius="8" Padding="10,9">
                                        <TextBlock Text="PKR — Rs" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Language" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource Brush.CardHover}" CornerRadius="8" Padding="10,9">
                                        <TextBlock Text="{Binding LanguageDisplay}" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Theme" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                      Padding="9,7" FontSize="14" Width="180" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- STEP 3: Tables -->
                        <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Tables" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Set up your playing tables. You can add or remove tables and set an hourly rate."
                                       Style="{StaticResource Text.Body}" Margin="0,6,0,12" />

                            <!-- Column headers -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="2" Text="Rate/hr" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="3" Text="Active" Style="{StaticResource Text.Caption}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Tables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0" Padding="8,6" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding TableTypes}" SelectedItem="{Binding Type}"
                                                      Margin="0,0,8,0" Padding="8,5" />
                                            <TextBox Grid.Column="2" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0" Padding="8,6" />
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsActive}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />
                                            <Button Grid.Column="4" Content="✕"
                                                    Command="{Binding DataContext.RemoveTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Secondary}" Padding="6,4" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="+ Add table" Command="{Binding AddTableCommand}"
                                        Style="{StaticResource Button.Secondary}" Margin="0,0,16,0" />
                                <TextBlock Text="Copy rate to all:" Style="{StaticResource Text.Body}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding BulkRateText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" Padding="8,6" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Apply" Command="{Binding ApplyRateToAllCommand}"
                                        Style="{StaticResource Button.Secondary}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- STEP 4: Receipt & printer -->
                        <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Receipt &amp; printer" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Basic preferences only. You can set up printing later."
                                       Style="{StaticResource Text.Body}" Margin="0,6,0,14" />

                            <TextBlock Text="Receipt width" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="58 mm" IsChecked="{Binding Is58mm}" Foreground="{DynamicResource Brush.Text}" Margin="0,0,20,0" />
                                <RadioButton Content="80 mm" IsChecked="{Binding Is80mm}" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>

                            <TextBlock Text="Printer name (optional)" Style="{StaticResource Text.Caption}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="300" HorizontalAlignment="Left" />

                            <CheckBox Content="Print receipts automatically after payment" IsChecked="{Binding AutoPrintReceipt}"
                                      Foreground="{DynamicResource Brush.Text}" Margin="0,16,0,0" />
                        </StackPanel>

                        <!-- STEP 5: Owner account -->
                        <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Owner account" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Create the main account. It has full control of the system."
                                       Style="{StaticResource Text.Body}" Margin="0,6,0,14" />

                            <TextBlock Text="Display name *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding OwnerDisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />

                            <TextBlock Text="Username *" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding OwnerUsername, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Password *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ctrl:CredentialBox Password="{Binding OwnerPassword, Mode=TwoWay}"
                                                        Reveal="{Binding ShowSecrets}" SecretName="password" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Confirm password *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ctrl:CredentialBox Password="{Binding OwnerConfirmPassword, Mode=TwoWay}"
                                                        Reveal="{Binding ShowSecrets}" SecretName="password" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PIN (optional)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ctrl:CredentialBox Password="{Binding OwnerPin, Mode=TwoWay}"
                                                        Reveal="{Binding ShowSecrets}" SecretName="PIN" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Confirm PIN" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <ctrl:CredentialBox Password="{Binding OwnerConfirmPin, Mode=TwoWay}"
                                                        Reveal="{Binding ShowSecrets}" SecretName="PIN" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding PinHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />

                            <CheckBox Content="Show password and PIN" IsChecked="{Binding ShowSecrets}"
                                      Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- STEP 6: Backup -->
                        <StackPanel Visibility="{Binding IsStep6, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Backup" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Choose where automatic backups will be saved. You can change this later."
                                       Style="{StaticResource Text.Body}" Margin="0,6,0,14" />

                            <TextBlock Text="Backup folder" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9,8" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="Choose…" Command="{Binding ChooseBackupFolderCommand}"
                                        Style="{StaticResource Button.Secondary}" />
                            </Grid>
                        </StackPanel>

                        <!-- STEP 7: Review -->
                        <StackPanel Visibility="{Binding IsStep7, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Review &amp; finish" Style="{StaticResource Text.Heading}" Margin="0,0,0,12" />
                            <Border Background="{DynamicResource Brush.CardHover}" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,3"><TextBlock Text="Club name" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding ReviewClubName}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Active tables" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding ReviewTableCount}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Receipt width" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding ReviewReceiptWidth}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Owner username" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding ReviewOwnerUsername}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Backup location" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding ReviewBackupLocation}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="320" /></Grid>
                                    <TextBlock Text="Rates" Style="{StaticResource Text.Caption}" Margin="0,10,0,2" />
                                    <TextBlock Text="{Binding ReviewRatesSummary}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="For your security, passwords and PINs are not shown."
                                       Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="32,4,32,26">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                    <Grid>
                        <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisible}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Exit" Command="{Binding ExitCommand}" Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,10,0"
                                    Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisible}}" />
                            <Button Content="Skip for now" Command="{Binding SkipStepCommand}" Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,10,0"
                                    Visibility="{Binding ShowSkip, Converter={StaticResource BoolToVisible}}" />
                            <Button Content="Start Setup" Command="{Binding StartSetupCommand}" Style="{StaticResource Button.Primary}"
                                    Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisible}}" />
                            <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource Button.Primary}"
                                    Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisible}}" />
                            <Button Content="Finish setup" Command="{Binding FinishCommand}" Style="{StaticResource Button.Primary}"
                                    Visibility="{Binding ShowFinish, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
