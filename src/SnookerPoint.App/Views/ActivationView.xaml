<UserControl x:Class="SnookerPoint.App.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Primary}">
                        <TextBlock Text="SP" Foreground="{DynamicResource Brush.OnPrimary}" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Snooker Point — Activation" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Exit" Command="{Binding ExitCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28" ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center">

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                           Visibility="{Binding RemainingText, Converter={StaticResource NullToCollapsed}}" />

                <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                     DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,14,0,0" />

                <!-- Installation code -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Your Installation Code" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ClubName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Send this code to Snooker Point to receive your licence. No internet is required."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBox Text="{Binding InstallationCode, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="15"
                                 Padding="12,10" TextWrapping="Wrap" Background="{DynamicResource Brush.Card}"
                                 Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" />
                        <Button Content="Copy Installation Code" Command="{Binding CopyInstallationCodeCommand}"
                                Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Activate -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Activate your licence" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="Paste the licence text you received, or import the licence file, then click Activate."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <TextBox Text="{Binding LicenseTextInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinLines="5" MaxLines="10" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" Padding="10,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Import Licence File…" Command="{Binding ImportLicenceCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                            <Button Content="Activate" Command="{Binding ActivateCommand}" Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recovery actions while expired -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0"
                        Visibility="{Binding IsExpiredMode, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Your data is safe" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="Your business data has not been changed. While the trial is ended you can still back up or restore your data and view diagnostics."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <WrapPanel>
                            <Button Content="Back up data" Command="{Binding CreateBackupCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                            <Button Content="Restore backup" Command="{Binding RestoreBackupCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                            <Button Content="Diagnostics" Command="{Binding DiagnosticsCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,16,0,0"
                           Text="Need help? Copy your Installation Code and send it to Snooker Point support. You'll receive a licence file or licence text to paste above. Activation works fully offline." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
