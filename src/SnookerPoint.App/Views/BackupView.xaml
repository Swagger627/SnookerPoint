<UserControl x:Class="SnookerPoint.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Backup &amp; restore" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <TextBlock Text="Keep your data safe." Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Open backups folder" Command="{Binding OpenBackupsFolderCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28" ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
                <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                     DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,0,0,14" />

                <!-- Create -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Create a backup now" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="Includes the database, product images and receipts, with an integrity manifest." Style="{StaticResource Text.Caption}" Margin="0,2,0,10" />
                        <TextBlock Text="Description (optional)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="420" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBox Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="420" VerticalAlignment="Center"
                                     ToolTip="Leave blank to use the default backups folder." />
                            <Button Content="Choose folder…" Command="{Binding ChooseFolderCommand}" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0" />
                        </StackPanel>
                        <Button Content="Create backup" Command="{Binding CreateBackupCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Restore confirmation -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Restore" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="Restoring REPLACES all current data. A safety backup is made first. Type RESTORE below, then click Restore on a backup."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <TextBox Text="{Binding RestoreConfirmation, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="240" HorizontalAlignment="Left"
                                 ToolTip="Type RESTORE to enable restore." />
                    </StackPanel>
                </Border>

                <!-- List -->
                <TextBlock Text="Previous backups" Style="{StaticResource Text.Heading}" Margin="2,4,0,8" />
                <Border Style="{StaticResource Card}" Padding="10"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CreatedText}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ValidationStatus}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                       Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Validate" Command="{Binding DataContext.ValidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0" />
                                            <Button Content="Restore" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}"
                                                    Visibility="{Binding DataContext.CanRestore, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="No backups yet. Create one above to protect your data." Style="{StaticResource Text.Body}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
