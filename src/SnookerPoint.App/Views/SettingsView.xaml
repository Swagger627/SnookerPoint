<UserControl x:Class="SnookerPoint.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="Settings" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28" ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                     DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,0,0,14" />

                <!-- Licence -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding CanViewLicence, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Licence" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LicenceStatus}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding LicenceDetail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="Installation Code" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding InstallationCode, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 Padding="9,7" TextWrapping="Wrap" Width="420" HorizontalAlignment="Left" />
                        <Button Content="{Binding ActivateButtonText}" Command="{Binding OpenActivationCommand}"
                                Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Visibility="{Binding ShowActivateButton, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </Border>

                <!-- Club profile -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding CanManageSettings, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Club profile" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Club name" Style="{StaticResource Text.Caption}" />
                        <TextBox Text="{Binding ClubName, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="380" HorizontalAlignment="Left" Margin="0,2,0,8" />
                        <TextBlock Text="Address" Style="{StaticResource Text.Caption}" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="380" HorizontalAlignment="Left" Margin="0,2,0,8" />
                        <TextBlock Text="Phone" Style="{StaticResource Text.Caption}" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="240" HorizontalAlignment="Left" Margin="0,2,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Receipt width (mm)" Style="{StaticResource Text.Caption}" />
                                <ComboBox ItemsSource="{Binding ReceiptWidths}" SelectedItem="{Binding ReceiptWidth}" Width="100" Padding="8,7" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Content="Auto-print receipts" IsChecked="{Binding AutoPrintReceipt}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>
                        <Button Content="Save club profile" Command="{Binding SaveProfileCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tax & service -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding CanConfigureTax, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Tax &amp; service charge" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="Off by default. Changes apply to new sales only; completed sales never change." Style="{StaticResource Text.Caption}" Margin="0,2,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Enable tax" IsChecked="{Binding TaxEnabled}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Width="130" />
                            <TextBox Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="90" IsEnabled="{Binding TaxEnabled}" />
                            <TextBlock Text="%" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Enable service" IsChecked="{Binding ServiceEnabled}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Width="130" />
                            <TextBox Text="{Binding ServicePercent, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="90" IsEnabled="{Binding ServiceEnabled}" />
                            <TextBlock Text="%" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Border Background="{DynamicResource Brush.AccentSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Checkout preview" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding PreviewText}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Save tax &amp; service" Command="{Binding SaveTaxServiceCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Backups -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding CanManageBackupSettings, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="Automatic backups" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox Content="Enable automatic backups" IsChecked="{Binding AutoBackupEnabled}" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6" />
                        <CheckBox Content="Once per day" IsChecked="{Binding AutoBackupDaily}" Foreground="{DynamicResource Brush.Text}" Margin="20,0,0,6" />
                        <CheckBox Content="When the app closes" IsChecked="{Binding AutoBackupOnClose}" Foreground="{DynamicResource Brush.Text}" Margin="20,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Keep last" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Retention, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="70" />
                            <TextBlock Text="backups" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="380" VerticalAlignment="Center"
                                     ToolTip="Leave blank for the default backups folder." />
                            <Button Content="Choose folder…" Command="{Binding ChooseBackupFolderCommand}" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}">
                            <Run Text="Last automatic backup: " /><Run Text="{Binding LastAutoBackup, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Save backup settings" Command="{Binding SaveBackupSettingsCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Quick links -->
                <TextBlock Text="More settings" Style="{StaticResource Text.Heading}" Margin="2,4,0,10" />
                <WrapPanel>
                    <Button Content="Tables" Command="{Binding OpenTablesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                    <Button Content="Staff &amp; roles" Command="{Binding OpenStaffCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                    <Button Content="Backup &amp; restore" Command="{Binding OpenBackupCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                    <Button Content="Database &amp; diagnostics" Command="{Binding OpenAdminCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                    <Button Content="Audit log" Command="{Binding OpenAuditCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                    <Button Content="My account (security)" Command="{Binding OpenAccountCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
