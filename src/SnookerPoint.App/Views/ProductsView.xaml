<UserControl x:Class="SnookerPoint.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Products" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <TextBlock Text="Catalogue, barcodes and prices." Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource Brush.Text}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Categories" Command="{Binding OpenCategoriesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Inventory" Command="{Binding OpenInventoryCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar: search + filters + actions -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="280" Padding="8,7" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown"
                             ToolTip="Search by name, SKU or barcode. Scan a barcode and press Enter." />
                    <ComboBox Width="170" Margin="10,0,0,0" Padding="8,7" VerticalAlignment="Center"
                              ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}"
                              DisplayMemberPath="Name" />
                    <ComboBox Width="130" Margin="10,0,0,0" Padding="8,7" VerticalAlignment="Center"
                              ItemsSource="{Binding ActiveFilters}" SelectedItem="{Binding SelectedActiveFilter}"
                              DisplayMemberPath="Label" />
                    <CheckBox Content="Low stock only" IsChecked="{Binding LowStockOnly}"
                              Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" IsEnabled="{Binding CanImport}"
                            Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Export CSV" Command="{Binding ExportCatalogueCommand}" IsEnabled="{Binding CanExport}"
                            Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Template" Command="{Binding DownloadTemplateCommand}" IsEnabled="{Binding CanExport}"
                            Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Add product" Command="{Binding AddProductCommand}" IsEnabled="{Binding CanManage}"
                            Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>

            <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                 DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Product list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="28,12,28,24"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MinWidth="980">

                <!-- Empty state -->
                <Border Style="{StaticResource Card}" Padding="28" Margin="0,8,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No products yet" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0"
                                   Text="Scan a barcode or press Add product to create your first item. You can also import a CSV file." />
                    </StackPanel>
                </Border>

                <!-- Header -->
                <Grid Margin="0,0,0,6" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Product" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="2" Text="SKU / barcode" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="3" Text="Category" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="4" Text="Price" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="5" Text="Stock" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="7" Text="Actions" Style="{StaticResource Text.Caption}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="290" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Image / placeholder -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="—" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisible}}" />
                                            <Image Source="{Binding ImageFullPath}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisible}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Variant}" Style="{StaticResource Text.Caption}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Size}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sku}" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Barcode}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding CategoryName}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding PriceText}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding StockText}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />

                                    <WrapPanel Grid.Column="7" VerticalAlignment="Center">
                                        <Button Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Duplicate" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="{Binding ActiveToggleText}" Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
