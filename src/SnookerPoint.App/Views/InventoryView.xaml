<UserControl x:Class="SnookerPoint.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Inventory" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <TextBlock Text="Stock levels and movements." Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource Brush.Text}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Products" Command="{Binding OpenProductsCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="280" Padding="8,7" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by name, SKU or barcode." />
                <ComboBox Width="170" Margin="10,0,0,0" Padding="8,7" VerticalAlignment="Center"
                          ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}"
                          DisplayMemberPath="Name" />
                <CheckBox Content="Low stock only" IsChecked="{Binding LowStockOnly}"
                          Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <CheckBox Content="Include inactive" IsChecked="{Binding IncludeInactive}"
                          Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                 DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Inventory list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="28,12,28,24"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MinWidth="1080">

                <Border Style="{StaticResource Card}" Padding="24" Margin="0,8,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center"
                               Text="No products to show. Add products first, then manage their stock here." />
                </Border>

                <!-- Header -->
                <Grid Margin="0,0,0,6" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Product" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="2" Text="Stock" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="3" Text="Reorder" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="5" Text="Price" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="6" Text="Last movement" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="7" Text="Actions" Style="{StaticResource Text.Caption}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Sku}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding StockText}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ReorderText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding PriceText}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding LastMovementText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />

                                    <WrapPanel Grid.Column="7" VerticalAlignment="Center">
                                        <Button Content="Stock in" Command="{Binding DataContext.StockInCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Adjust" Command="{Binding DataContext.AdjustCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Waste" Command="{Binding DataContext.WasteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Damage" Command="{Binding DataContext.DamageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Return" Command="{Binding DataContext.SupplierReturnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="History" Command="{Binding DataContext.HistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
