<UserControl x:Class="SnookerPoint.App.Views.BookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bookings" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <TextBlock Text="Reserve tables in advance and start them on arrival." Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="New booking" Command="{Binding NewBookingCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                            Visibility="{Binding CanManage, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="Tables" Command="{Binding OpenTablesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar / filters -->
        <StackPanel Grid.Row="1" Margin="28,16,28,0">
            <WrapPanel>
                <TextBox Width="180" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                         Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by customer name." />
                <TextBox Width="150" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                         Text="{Binding SearchPhone, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by phone." />
                <ComboBox Width="160" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                          ItemsSource="{Binding TableFilters}" SelectedItem="{Binding SelectedTable}" DisplayMemberPath="Name" />
                <ComboBox Width="150" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                          ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label" />
                <DatePicker Width="150" VerticalAlignment="Center" Margin="0,0,10,10"
                            SelectedDate="{Binding FilterDate}" />
                <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,0,10" />
            </WrapPanel>
            <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                 DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="28,12,28,24"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MinWidth="1000">
                <Border Style="{StaticResource Card}" Padding="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center"
                               Text="No bookings match your filters. Create a booking to reserve a table." />
                </Border>

                <Grid Margin="0,0,0,6" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Status" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="2" Text="Phone" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="3" Text="When" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="4" Text="Length" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="5" Text="Players" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="6" Text="Table" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="7" Text="Actions" Style="{StaticResource Text.Caption}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding StatusBrush}" CornerRadius="10" Padding="10,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomerName}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Visibility="{Binding Notes, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Phone}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WhenText}" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="12">
                                            <Run Text="until " /><Run Text="{Binding EndText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding PlayersText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding TableName}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="7" VerticalAlignment="Center">
                                        <Button Content="Start" Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Primary}" Margin="0,0,6,6"
                                                Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisible}}" />
                                        <Button Content="Check in" Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                Visibility="{Binding ShowCheckIn, Converter={StaticResource BoolToVisible}}" />
                                        <Button Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                Visibility="{Binding ShowEdit, Converter={StaticResource BoolToVisible}}" />
                                        <Button Content="No show" Command="{Binding DataContext.MarkNoShowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                Visibility="{Binding ShowNoShow, Converter={StaticResource BoolToVisible}}" />
                                        <Button Content="Cancel" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisible}}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
