<UserControl x:Class="SnookerPoint.App.Views.NewSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="New Sale" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <TextBlock Text="Walk-in and table checkout." Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Sales history" Command="{Binding OpenSalesHistoryCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <ctrl:FeedbackBanner Grid.Row="1" Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                             DismissCommand="{Binding Feedback.DismissCommand}" Margin="28,14,28,0" />

        <!-- Main POS: products (left) + cart (right) -->
        <Grid Grid.Row="2" Margin="28,14,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: search + product list + awaiting/held -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchBox" Grid.Row="0" Padding="10,9" FontSize="14"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown"
                         ToolTip="Search by name/SKU, or scan a barcode and press Enter." />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                              ctrl:SmoothScrollBehavior.Enabled="True">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource Button.Tile}" Width="200" Height="92">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PriceText}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Sku}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Awaiting checkout + held -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" MaxHeight="180">
                        <StackPanel>
                            <TextBlock Text="Awaiting checkout" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="No table sessions awaiting checkout." Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding Awaiting.Count, Converter={StaticResource NullToCollapsed}, FallbackValue=Visible}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130" ctrl:SmoothScrollBehavior.Enabled="True">
                                <ItemsControl ItemsSource="{Binding Awaiting}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Left" Margin="0,3"
                                                    Command="{Binding DataContext.StartTableCheckoutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}">
                                                <StackPanel>
                                                    <TextBlock Foreground="{DynamicResource Brush.Text}">
                                                        <Run Text="#" /><Run Text="{Binding SessionNumber, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TableNames, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" MaxHeight="180">
                        <StackPanel>
                            <TextBlock Text="Held sales" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130" ctrl:SmoothScrollBehavior.Enabled="True">
                                <ItemsControl ItemsSource="{Binding Held}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Left" Margin="0,3"
                                                    Command="{Binding DataContext.ResumeHeldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}">
                                                <TextBlock Foreground="{DynamicResource Brush.Text}">
                                                    <Run Text="{Binding Label, Mode=OneWay, TargetNullValue=Sale}" /><Run Text=" · " /><Run Text="{Binding Total, Mode=OneWay}" />
                                                </TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- RIGHT: cart -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Current sale" Foreground="{DynamicResource Brush.Text}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SaleLabel}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding SaleLabel, Converter={StaticResource NullToCollapsed}}" Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                                  ctrl:SmoothScrollBehavior.Enabled="True">
                        <StackPanel>
                            <TextBlock Text="No items yet. Scan or tap a product to add it."
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="−" Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Padding="10,2" />
                                                        <TextBlock Text="{Binding QuantityText}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="10,0" />
                                                        <Button Content="+" Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Padding="10,2" />
                                                        <TextBlock Text="{Binding UnitPriceText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding LineTotalText}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                        <Button Content="Price" Command="{Binding DataContext.OverridePriceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Padding="8,2"
                                                                Visibility="{Binding DataContext.CanOverridePrice, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisible}}" Margin="0,0,6,0" />
                                                        <Button Content="Remove" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Padding="8,2" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Totals -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid Margin="0,2">
                            <TextBlock Text="Subtotal" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{Binding SubtotalText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,2" Visibility="{Binding HasTableCharge, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Table charge" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{Binding TableChargeText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,2" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Discount" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{Binding DiscountText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Total" Foreground="{DynamicResource Brush.Text}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <WrapPanel>
                            <Button Content="Discount" Command="{Binding ApplyDiscountCommand}" Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,8,8" Visibility="{Binding CanApplyDiscount, Converter={StaticResource BoolToVisible}}" />
                            <Button Content="Remove discount" Command="{Binding RemoveDiscountCommand}" Style="{StaticResource Button.Secondary}"
                                    Margin="0,0,8,8" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisible}}" />
                            <Button Content="Hold" Command="{Binding HoldCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <Button Content="Pay Now" Command="{Binding PayNowCommand}" Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Stretch" Padding="16,12" FontSize="15" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
