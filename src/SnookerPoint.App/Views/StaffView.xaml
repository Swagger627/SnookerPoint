<UserControl x:Class="SnookerPoint.App.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Staff management" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <TextBlock Text="Accounts, roles and login credentials." Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource Brush.Text}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Tables" Command="{Binding TablesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Margin="28,18,28,0">
            <Button Content="Add staff account" Command="{Binding AddStaffCommand}" IsEnabled="{Binding CanManage}"
                    Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" />
            <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                 DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,14,0,0" />
        </StackPanel>

        <!-- Staff list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="28,16,28,24"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MinWidth="940">
                <!-- Header -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name / username" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="1" Text="Role" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="2" Text="PIN" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="4" Text="Actions" Style="{StaticResource Text.Caption}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RoleText}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PinText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                    <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Button Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Password" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Temp" Command="{Binding DataContext.TempPasswordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="PIN" Command="{Binding DataContext.SetPinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="{Binding ActiveToggleText}" Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding CanToggleActive}"
                                                Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                        <Button Content="Clear lockout" Command="{Binding DataContext.ClearLockoutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding IsLockedOut}"
                                                Style="{StaticResource Button.Secondary}" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
