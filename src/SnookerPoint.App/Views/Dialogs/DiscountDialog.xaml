<Window x:Class="SnookerPoint.App.Views.Dialogs.DiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply discount"
        FontFamily="{StaticResource Font.Ui}"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="Apply discount" Style="{StaticResource Text.Heading}" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <RadioButton Content="Fixed (Rs)" IsChecked="{Binding IsFixed}" Foreground="{DynamicResource Brush.Text}" Margin="0,0,18,0" />
                <RadioButton Content="Percentage (%)" IsChecked="{Binding IsPercentage}" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>

            <TextBlock Text="Value" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <TextBox x:Name="ValueBox" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />

            <TextBlock Text="Reason" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Apply" Click="OnConfirm" IsDefault="True" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
