<Window x:Class="SnookerPoint.App.Views.Dialogs.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
        Title="Forgot password or PIN"
        FontFamily="{StaticResource Font.Ui}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="Forgot password or PIN?" Style="{StaticResource Text.Heading}" />

            <!-- Staff guidance (always shown) -->
            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Staff accounts" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Text="Ask the club Owner or an Administrator to reset your password or PIN from Staff Management. They can issue a temporary password you change at next login. Disabled accounts must be re-enabled first." />
                </StackPanel>
            </Border>

            <!-- Owner offline recovery -->
            <StackPanel Visibility="{Binding OwnerRecoveryAvailable, Converter={StaticResource BoolToVisible}}" Margin="0,16,0,0">
                <TextBlock Text="Recover the Owner account" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="0,4,0,10"
                           Text="Enter the Owner username and the offline recovery code to set a new password." />

                <TextBlock Text="Owner username" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />

                <TextBlock Text="Recovery code" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                <TextBox Text="{Binding RecoveryCode, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" FontFamily="Consolas" />

                <TextBlock Text="New password" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                <ctrl:CredentialBox Password="{Binding NewPassword, Mode=TwoWay}" Reveal="{Binding RevealSecrets}" SecretName="password" />
                <TextBlock Text="Confirm new password" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                <ctrl:CredentialBox Password="{Binding ConfirmPassword, Mode=TwoWay}" Reveal="{Binding RevealSecrets}" SecretName="password" />

                <TextBlock Text="New PIN (optional)" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                <ctrl:CredentialBox Password="{Binding NewPin, Mode=TwoWay}" Reveal="{Binding RevealSecrets}" SecretName="PIN" />
                <TextBlock Text="Confirm new PIN" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                <ctrl:CredentialBox Password="{Binding ConfirmPin, Mode=TwoWay}" Reveal="{Binding RevealSecrets}" SecretName="PIN" />

                <CheckBox Content="Show password and PIN" IsChecked="{Binding RevealSecrets}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Close" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Recover account" IsDefault="True" Click="OnConfirm" Style="{StaticResource Button.Primary}"
                        Visibility="{Binding OwnerRecoveryAvailable, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
