<Window x:Class="SnookerPoint.App.Views.Dialogs.ProductEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
        Title="Product"
        FontFamily="{StaticResource Font.Ui}"
        Width="620" Height="620" MaxHeight="760"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource Text.Heading}" Margin="24,20,24,8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,4"
                          ctrl:SmoothScrollBehavior.Enabled="True">
                <StackPanel>
                    <TextBlock Text="Barcode (scan or type)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <TextBox x:Name="BarcodeBox" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />

                    <TextBlock Text="Product name *" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Internal SKU *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Category *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name" Padding="8,7" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Brand" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Flavour / variant" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Variant, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Size" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Unit" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" Padding="8,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Purchase cost (Rs)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CostRupees, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Selling price (Rs) *" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PriceRupees, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <CheckBox Content="Track inventory for this product" IsChecked="{Binding TrackInventory}"
                                      Foreground="{DynamicResource Brush.Text}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Reorder / low-stock level" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ReorderLevelText, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding ShowOpeningStock, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="Opening quantity" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding OpeningQuantityText, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Allow stock to go below zero" IsChecked="{Binding AllowNegativeStock}"
                                      Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Image" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="88" Height="88" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="No image" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasImagePreview, Converter={StaticResource InverseBoolToVisible}}" />
                                <Image Source="{Binding ImagePreviewPath}" Stretch="UniformToFill"
                                       Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVisible}}" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Content="Choose image…" Click="OnChooseImage" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
                            <Button Content="Remove image" Click="OnRemoveImage" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Notes" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="8,7"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                    <Button Content="Save product" Click="OnConfirm" IsDefault="True" Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
