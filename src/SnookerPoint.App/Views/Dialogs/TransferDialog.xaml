<Window x:Class="SnookerPoint.App.Views.Dialogs.TransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Session"
        FontFamily="{StaticResource Font.Ui}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="Transfer Session" Style="{StaticResource Text.Heading}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,14" TextWrapping="Wrap">
                <Run Text="Move from" /><Run Text=" " /><Run Text="{Binding SourceTableName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" to another available table. Elapsed time is kept; the new table's rate applies from now." />
            </TextBlock>

            <TextBlock Text="Destination table" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}"
                      DisplayMemberPath="Name" Padding="9,7" />

            <Grid Margin="0,10,0,0">
                <TextBlock Text="Destination rate" Style="{StaticResource Text.Body}" />
                <TextBlock Text="{Binding DestinationRateText}" Foreground="{DynamicResource Brush.Text}"
                           FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="Reason" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
            <TextBox x:Name="ReasonBox" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Transfer" IsDefault="True" Click="OnConfirm" Style="{StaticResource Button.Primary}"
                        IsEnabled="{Binding HasDestinations}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
