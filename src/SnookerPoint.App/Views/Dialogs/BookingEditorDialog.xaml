<Window x:Class="SnookerPoint.App.Views.Dialogs.BookingEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        FontFamily="{StaticResource Font.Ui}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" />
            <TextBlock Text="Times are entered in your local time." Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

            <TextBlock Text="Customer name" Style="{StaticResource Text.Caption}" Margin="0,16,0,4" />
            <TextBox x:Name="NameBox" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />

            <TextBlock Text="Phone (optional)" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />

            <TextBlock Text="Table" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                      DisplayMemberPath="Display" Padding="9,8" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding Date}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Start time (e.g. 18:30)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Expected duration (minutes)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Players (optional)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PlayerCount, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Notes (optional)" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" TextWrapping="Wrap" MinLines="2" AcceptsReturn="True" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="{Binding ConfirmText}" IsDefault="True" Click="OnConfirm" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
