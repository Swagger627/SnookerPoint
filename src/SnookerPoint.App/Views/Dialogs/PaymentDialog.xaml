<Window x:Class="SnookerPoint.App.Views.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take payment"
        FontFamily="{StaticResource Font.Ui}"
        Width="520" Height="620" MaxHeight="760"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Take payment" Style="{StaticResource Text.Heading}" />

            <!-- Amount due / remaining -->
            <Grid Grid.Row="1" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Amount due" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding AmountDueText}" Foreground="{DynamicResource Brush.Text}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Remaining" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding RemainingText}" Foreground="{DynamicResource Brush.Accent}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- Add-payment entry + added rows -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Method" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Name" Padding="8,7" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Amount (Rs)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding IsCashSelected, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="Cash received (Rs)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CashReceivedText, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsCashSelected, Converter={StaticResource InverseBoolToVisible}}">
                            <TextBlock Text="Reference (optional)" Style="{StaticResource Text.Caption}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />
                        </StackPanel>

                        <Button Content="Add payment" Command="{Binding AddPaymentCommand}"
                                Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Payments" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding MethodName}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AmountText}" Foreground="{DynamicResource Brush.Text}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Content="Remove" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Change: " Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChangeText}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="16,0,0,0"
                           VerticalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Complete payment" Click="OnComplete" IsEnabled="{Binding CanComplete}" IsDefault="True" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
