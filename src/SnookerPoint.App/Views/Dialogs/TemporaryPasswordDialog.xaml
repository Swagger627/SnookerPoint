<Window x:Class="SnookerPoint.App.Views.Dialogs.TemporaryPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary password"
        FontFamily="{StaticResource Font.Ui}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Temporary password" Style="{StaticResource Text.Heading}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Body}" Margin="0,6,0,16"
                       Text="Share this with the staff member securely. They will be asked to set their own password when they next sign in. It is shown only once and will not be shown again." />

            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14">
                <TextBlock x:Name="SecretText" FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Copy" Click="OnCopy" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Done" IsDefault="True" IsCancel="True" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Right" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
