<Window x:Class="SnookerPoint.App.Views.Dialogs.CsvImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import products from CSV"
        FontFamily="{StaticResource Font.Ui}"
        Width="720" Height="620"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Preview" Style="{StaticResource Text.Heading}" />
            <TextBlock Grid.Row="1" Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />

            <!-- File errors -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding FileErrors}" Margin="0,24,0,0"
                          Visibility="{Binding HasFileErrors, Converter={StaticResource BoolToVisible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                      RowBackground="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      Foreground="{DynamicResource Brush.Text}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="60" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="If a SKU or barcode already exists:" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Skip it" IsChecked="{Binding Skip}" Foreground="{DynamicResource Brush.Text}" Margin="0,0,16,0" />
                    <RadioButton Content="Update matching SKU" IsChecked="{Binding UpdateBySku}" Foreground="{DynamicResource Brush.Text}" Margin="0,0,16,0" />
                    <RadioButton Content="Update matching barcode" IsChecked="{Binding UpdateByBarcode}" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Import" Click="OnConfirm" IsDefault="True" IsEnabled="{Binding CanImport}" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
