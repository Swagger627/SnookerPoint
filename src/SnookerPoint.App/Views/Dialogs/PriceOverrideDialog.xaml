<Window x:Class="SnookerPoint.App.Views.Dialogs.PriceOverrideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change price"
        FontFamily="{StaticResource Font.Ui}"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="Change line price" Style="{StaticResource Text.Heading}" />
            <TextBlock Text="{Binding ProductName}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                <Run Text="Current: " /><Run Text="{Binding CurrentPriceText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <TextBlock Text="New unit price (Rs)" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
            <TextBox x:Name="PriceBox" Text="{Binding NewPriceText, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />

            <TextBlock Text="Reason" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Padding="8,7" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Save price" Click="OnConfirm" IsDefault="True" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
