<Window x:Class="SnookerPoint.App.Views.Dialogs.SetCredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
        Title="{Binding Title}"
        FontFamily="{StaticResource Font.Ui}"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" />
            <TextBlock Text="{Binding Prompt}" Style="{StaticResource Text.Body}" Margin="0,6,0,18" TextWrapping="Wrap" />

            <TextBlock Text="New value" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
            <ctrl:CredentialBox x:Name="ValueBox" Password="{Binding Value, Mode=TwoWay}"
                                Reveal="{Binding Reveal}" SecretName="{Binding SecretName}" />

            <TextBlock Text="Confirm" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <ctrl:CredentialBox Password="{Binding ConfirmValue, Mode=TwoWay}"
                                Reveal="{Binding Reveal}" SecretName="{Binding SecretName}" />

            <CheckBox Content="Show value" IsChecked="{Binding Reveal}"
                      Foreground="{DynamicResource Brush.TextMuted}" Margin="0,12,0,0" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Save" IsDefault="True" Click="OnConfirm" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
