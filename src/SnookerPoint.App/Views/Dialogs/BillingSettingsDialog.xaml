<Window x:Class="SnookerPoint.App.Views.Dialogs.BillingSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Billing Settings"
        FontFamily="{StaticResource Font.Ui}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="Billing Settings" Style="{StaticResource Text.Heading}" />
            <TextBlock Text="These apply to new sessions. Existing sessions keep the settings they started with."
                       Style="{StaticResource Text.Caption}" Margin="0,6,0,14" TextWrapping="Wrap" />

            <TextBlock Text="Billing method" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Exact time" IsChecked="{Binding IsExact}" Foreground="{DynamicResource Brush.Text}" Margin="0,0,20,0" />
                <RadioButton Content="Round up" IsChecked="{Binding IsRoundUp}" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>

            <TextBlock Text="Round-up increment (minutes)" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
            <TextBox Text="{Binding IncrementText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Width="120" HorizontalAlignment="Left"
                     IsEnabled="{Binding IsRoundUp}" />

            <TextBlock Text="Minimum billable minutes" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
            <TextBox Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Width="120" HorizontalAlignment="Left" />

            <TextBlock Text="Grace period (minutes)" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
            <TextBox Text="{Binding GraceText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Width="120" HorizontalAlignment="Left" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Save" IsDefault="True" Click="OnConfirm" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
