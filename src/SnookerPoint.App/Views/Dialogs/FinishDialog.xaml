<Window x:Class="SnookerPoint.App.Views.Dialogs.FinishDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finish Session"
        FontFamily="{StaticResource Font.Ui}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}">
                <Run Text="Finish session #" /><Run Text="{Binding SessionNumber, Mode=OneWay}" />
            </TextBlock>

            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,2"><TextBlock Text="Started" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding StartText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="Finished" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding FinishText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="Elapsed" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding ElapsedText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="Paused" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding PausedText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="Billable" Style="{StaticResource Text.Body}" /><TextBlock Text="{Binding BillableText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" /></Grid>

                    <ItemsControl ItemsSource="{Binding Segments}" Margin="0,8,0,0"
                                  Visibility="{Binding HasMultipleSegments, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding TableName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RateText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,8,0,8" />
                    <Grid>
                        <TextBlock Text="Table charge" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ChargeText}" Foreground="{DynamicResource Brush.Accent}"
                                   FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="This charge will be saved as Awaiting Checkout. Payment is taken later."
                       Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />

            <TextBlock Text="Closing note (optional)" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
            <TextBox Text="{Binding ClosingNote, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" TextWrapping="Wrap" MinLines="2" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Finish &amp; save" IsDefault="True" Click="OnConfirm" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
