<Window x:Class="SnookerPoint.App.Views.Dialogs.CloseShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Shift"
        FontFamily="{StaticResource Font.Ui}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Border Background="{DynamicResource Brush.Surface}" Padding="24">
        <StackPanel>
            <TextBlock Text="Close Shift" Style="{StaticResource Text.Heading}" />
            <TextBlock Text="Count the cash in the drawer and enter the total. The variance is the difference from the expected amount."
                       Style="{StaticResource Text.Body}" Margin="0,6,0,18" />

            <Border Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10">
                <Grid>
                    <TextBlock Text="Expected cash" Style="{StaticResource Text.Body}" />
                    <TextBlock Text="{Binding ExpectedCashText}"
                               Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <TextBlock Text="Counted cash (Rs)" Style="{StaticResource Text.Caption}" Margin="0,16,0,4" />
            <TextBox x:Name="CountedBox" Text="{Binding CountedCashText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,7" FontSize="14" />

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Variance" Style="{StaticResource Text.Body}" />
                <TextBlock Text="{Binding VarianceText}"
                           Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="Closing note (optional)" Style="{StaticResource Text.Caption}" Margin="0,14,0,4" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,7" FontSize="14" TextWrapping="Wrap" MinLines="2" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" />
                <Button Content="Close Shift" IsDefault="True" Click="OnConfirm"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
