<UserControl x:Class="SnookerPoint.App.Views.ManageCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Categories" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <TextBlock Text="Group your products (e.g. Drinks, Snacks, Accessories)." Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource Brush.Text}"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Products" Command="{Binding OpenProductsCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,18,28,24"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" MinWidth="640">

                <!-- Add row -->
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Padding="8,7" VerticalAlignment="Center"
                                 Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="New category name (e.g. Drinks)" />
                        <Button Grid.Column="1" Content="Add category" Command="{Binding AddCommand}" IsEnabled="{Binding CanManage}"
                                Style="{StaticResource Button.Primary}" Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                     DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,0,0,14" />

                <!-- Empty state -->
                <Border Style="{StaticResource Card}" Padding="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center"
                               Text="No categories yet. Add your first one above — for example Drinks, Snacks or Accessories." />
                </Border>

                <!-- Category list -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProductCountText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />

                                    <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                        <Button Content="▲" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0" Padding="10,7" />
                                        <Button Content="▼" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0" Padding="10,7" />
                                        <Button Content="Save" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" Margin="0,0,6,0" />
                                        <Button Content="{Binding ActiveToggleText}" Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
