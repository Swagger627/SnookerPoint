<UserControl x:Class="SnookerPoint.App.Views.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tables" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Success}"
                                     Visibility="{Binding HasOpenShift, Converter={StaticResource BoolToVisible}}" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.TextSubtle}"
                                     Visibility="{Binding HasOpenShift, Converter={StaticResource InverseBoolToVisible}}" />
                            <TextBlock Text="{Binding ShiftStatusText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserDisplayName}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RoleName}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="History" Command="{Binding HistoryCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Manage" Command="{Binding ManageTablesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Visibility="{Binding CanManageTables, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="Billing" Command="{Binding EditBillingSettingsCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Visibility="{Binding CanManageBilling, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter + shift banner -->
        <StackPanel Grid.Row="1" Margin="28,18,28,0">
            <Border Background="{DynamicResource Brush.AccentSubtle}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                    Visibility="{Binding HasOpenShift, Converter={StaticResource InverseBoolToVisible}}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="No open shift" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                        <TextBlock Text="Open a shift to start, pause, transfer or finish table sessions."
                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Content="Open Shift" Command="{Binding OpenShiftCommand}" Style="{StaticResource Button.Primary}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Show:" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Width="150" Padding="9,6" />
                <Button Content="Refresh" Command="{Binding RefreshDashboardCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Table cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,16,28,24"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel>
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Body}"
                           Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}" Margin="2,8,0,0" />
                <ItemsControl ItemsSource="{Binding CardsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,14,14" Width="300">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TypeText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Status.Available}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InUse">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Paused}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding RateText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />

                                    <!-- Live session block -->
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSession, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="{Binding SessionNumberText}" Style="{StaticResource Text.Caption}" />
                                        <TextBlock Text="{Binding CustomerLabel}" Foreground="{DynamicResource Brush.Text}"
                                                   Visibility="{Binding HasCustomerLabel, Converter={StaticResource BoolToVisible}}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding ElapsedText}" Foreground="{DynamicResource Brush.Text}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding ChargeText}" Foreground="{DynamicResource Brush.Accent}" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Text="{Binding PausedText}" Style="{StaticResource Text.Caption}"
                                                   Visibility="{Binding HasPaused, Converter={StaticResource BoolToVisible}}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding StartedAtText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="by " /><Run Text="{Binding StartedByText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Start" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisible}}"
                                                IsEnabled="{Binding DataContext.HasOpenShift, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Pause" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"
                                                Visibility="{Binding IsInUse, Converter={StaticResource BoolToVisible}}"
                                                IsEnabled="{Binding DataContext.HasOpenShift, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Resume" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"
                                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisible}}"
                                                IsEnabled="{Binding DataContext.HasOpenShift, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Transfer" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"
                                                Visibility="{Binding HasSession, Converter={StaticResource BoolToVisible}}"
                                                IsEnabled="{Binding DataContext.HasOpenShift, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                Command="{Binding DataContext.TransferCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Finish" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"
                                                Visibility="{Binding HasSession, Converter={StaticResource BoolToVisible}}"
                                                IsEnabled="{Binding DataContext.HasOpenShift, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                Command="{Binding DataContext.FinishCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Correct" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"
                                                IsEnabled="{Binding DataContext.HasOpenShift, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                Command="{Binding DataContext.CorrectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                                                    <Binding Path="HasSession" />
                                                    <Binding Path="DataContext.CanCorrect" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                </MultiBinding>
                                            </Button.Visibility>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
