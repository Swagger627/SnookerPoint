<UserControl x:Class="SnookerPoint.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="Audit log" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Export CSV" Command="{Binding ExportCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Visibility="{Binding CanExport, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,16,28,0">
            <WrapPanel>
                <DatePicker Width="140" VerticalAlignment="Center" Margin="0,0,10,10" SelectedDate="{Binding FromDate}" ToolTip="From date" />
                <DatePicker Width="140" VerticalAlignment="Center" Margin="0,0,10,10" SelectedDate="{Binding ToDate}" ToolTip="To date" />
                <ComboBox Width="170" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                          ItemsSource="{Binding Actors}" SelectedItem="{Binding SelectedActor}" DisplayMemberPath="DisplayName" />
                <ComboBox Width="150" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                          ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" />
                <ComboBox Width="190" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                          ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" />
                <TextBox Width="140" Padding="8,7" VerticalAlignment="Center" Margin="0,0,10,10"
                         Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reference / record number" />
                <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,0,10" />
            </WrapPanel>
            <ctrl:FeedbackBanner Kind="{Binding Feedback.Kind}" Message="{Binding Feedback.Message}"
                                 DismissCommand="{Binding Feedback.DismissCommand}" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="28,12,28,8"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MinWidth="1000">
                <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="No audit events match your filters." Style="{StaticResource Text.Body}" TextAlignment="Center" />
                </Border>

                <Grid Margin="0,0,0,6" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Timestamp" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="1" Text="User" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="2" Text="Action" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="3" Text="Module" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="4" Text="Ref" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="5" Text="Summary" Style="{StaticResource Text.Caption}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding When}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding User}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Module}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Reference}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding Details}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <TextBlock Text="{Binding PageText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Previous" Command="{Binding PrevCommand}" IsEnabled="{Binding CanPrev}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
