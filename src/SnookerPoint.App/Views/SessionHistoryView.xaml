<UserControl x:Class="SnookerPoint.App.Views.SessionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="64" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock Text="Session history" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Tables" Command="{Binding TablesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Margin="28,18,28,0" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="16">
            <WrapPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Session #" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchSessionNumber, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="8,6" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="From" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="To" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Table" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding TableOptions}" SelectedItem="{Binding SelectedTable}" DisplayMemberPath="Name" Width="150" Padding="8,6" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Status" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="150" Padding="8,6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="28,16,28,24"
                      ctrl:SmoothScrollBehavior.Enabled="True">
            <StackPanel MinWidth="900">
                <!-- Header -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="1" Text="Date" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="2" Text="Table(s)" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="3" Text="Duration" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="4" Text="Charge" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="6" Text="Started by" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="7" Text="Finished by" Style="{StaticResource Text.Caption}" />
                </Grid>

                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Body}"
                           Visibility="{Binding EmptyMessage, Converter={StaticResource NullToCollapsed}}" Margin="2,8,0,0" />

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Tables}" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource Brush.Text}" />
                                    <TextBlock Grid.Column="4" Text="{Binding ChargeText}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Grid.Column="6" Text="{Binding StartedBy}" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Grid.Column="7" Text="{Binding FinishedBy}" Foreground="{DynamicResource Brush.TextMuted}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
