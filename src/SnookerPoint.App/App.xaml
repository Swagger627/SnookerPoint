<Application x:Class="SnookerPoint.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SnookerPoint.App.Controls"
             xmlns:vm="clr-namespace:SnookerPoint.App.ViewModels"
             xmlns:views="clr-namespace:SnookerPoint.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Reusable control styles (theme-agnostic; reference colour tokens
                    via DynamicResource). The active theme's token dictionary
                    (Themes/Dark.xaml or Themes/Light.xaml) is merged over this at
                    runtime by ThemeService.
                -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters -->
            <ctrl:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <ctrl:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
            <ctrl:NullOrEmptyToCollapsedConverter x:Key="NullToCollapsed" />
            <ctrl:AllTrueToVisibilityConverter x:Key="AllTrueToVisible" />
            <ctrl:InverseBoolConverter x:Key="InverseBool" />
            <ctrl:RoleNameConverter x:Key="RoleName" />

            <!-- View-model to view mapping (shell renders the active screen) -->
            <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
                <views:SetupWizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TablesViewModel}">
                <views:TablesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SessionHistoryViewModel}">
                <views:SessionHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManageTablesViewModel}">
                <views:ManageTablesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StaffViewModel}">
                <views:StaffView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountViewModel}">
                <views:AccountView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <views:ProductsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManageCategoriesViewModel}">
                <views:ManageCategoriesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewSaleViewModel}">
                <views:NewSaleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
                <views:SalesHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BookingsViewModel}">
                <views:BookingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                <views:BackupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdminViewModel}">
                <views:AdminView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditViewModel}">
                <views:AuditView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivationViewModel}">
                <views:ActivationView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
